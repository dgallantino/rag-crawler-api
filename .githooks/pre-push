#!/usr/bin/env bash
# Pre-push: run the default pytest suite before anything leaves the machine.
#
# Install (once per clone):
#   ./scripts/install-git-hooks.sh
#
# Bypass (use sparingly):
#   SKIP_PRE_PUSH_TESTS=1 git push
#   git push --no-verify

set -euo pipefail

if [[ "${SKIP_PRE_PUSH_TESTS:-}" == "1" ]]; then
  echo "pre-push: skipping tests because SKIP_PRE_PUSH_TESTS=1" >&2
  exit 0
fi

zero="$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')"
pushing_commits=0
while read -r local_ref local_oid remote_ref remote_oid; do
  if [[ -n "${local_oid:-}" && "$local_oid" != "$zero" ]]; then
    pushing_commits=1
    break
  fi
done

if [[ "$pushing_commits" -eq 0 ]]; then
  echo "pre-push: no commits being pushed (delete-only); skipping tests"
  exit 0
fi

root="$(git rev-parse --show-toplevel)"
cd "$root"

if ! command -v podman >/dev/null 2>&1; then
  echo "pre-push: podman is not installed; tests need it for testcontainers." >&2
  echo "pre-push: install Podman, then retry. Do not fall back to Docker." >&2
  exit 1
fi

runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
podman_sock="${runtime_dir}/podman/podman.sock"
if [[ ! -S "$podman_sock" ]]; then
  echo "pre-push: starting podman.socket..."
  if ! systemctl --user start podman.socket; then
    echo "pre-push: failed to start podman.socket (${podman_sock} missing)." >&2
    exit 1
  fi
fi

pytest_bin="${root}/venv/bin/pytest"
if [[ ! -x "$pytest_bin" ]]; then
  echo "pre-push: ${pytest_bin} not found." >&2
  echo "pre-push: create the venv and install test deps:" >&2
  echo "  python -m venv venv && ./venv/bin/pip install -r requirements-test.txt" >&2
  exit 1
fi

echo "pre-push: running default pytest suite (e2e/slow excluded)..."
if ! "$pytest_bin"; then
  echo >&2
  echo "pre-push: tests failed — push aborted." >&2
  echo "pre-push: fix the failures, or bypass with SKIP_PRE_PUSH_TESTS=1 git push" >&2
  echo "pre-push: (or git push --no-verify). Both skip the safety net." >&2
  exit 1
fi

echo "pre-push: tests passed"
exit 0
